{
  "name": "tcl-me-remo",
  "version": "0.1.0",
  "description": "Control a TCL Google TV from SteamOS over Bluetooth (power, input switching).",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit && tsc --noEmit -p preview/tsconfig.json",
    "preview": "node preview/shots.mjs",
    "preview:build": "node preview/build.mjs",
    "zip": "python3 scripts/build_zip.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "esbuild-wasm": "^0.25.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
